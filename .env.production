APP_NAME=SmartPonic
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://smartponic-dashboard.onrender.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=libsql
TURSO_DATABASE_URL=libsql://smartponic-db-hyelif.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Security keys for ESP32 HMAC
SMARTPONIC_API_KEY=smartponic-hq-key
SMARTPONIC_HMAC_SECRET=smartponic-hq-signature-secret
SMARTPONIC_AUTH_KEY=AQUA77
SMARTPONIC_REQUEST_MAX_AGE=300

# Telegram bot (set these in Render dashboard)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
