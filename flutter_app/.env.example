# ============================================================
# SmartPonic v2 — Local environment configuration
# ============================================================
# Copy this file to .env and fill in your Turso tokens.
# The .env file is gitignored and will NOT be committed.
#
# Usage:
#   .\run.ps1
#
# ============================================================
# Required: Turso database URL
# ============================================================
SMARTPONIC_TURSO_URL=https://smartponic-db-hyelif.aws-ap-northeast-1.turso.io/v2/pipeline

# ============================================================
# Required: Turso read-only token (for login + data viewing)
# ============================================================
SMARTPONIC_TURSO_READ_TOKEN=

# ============================================================
# Required: Turso write token (for relay commands)
# ============================================================
SMARTPONIC_TURSO_WRITE_TOKEN=
